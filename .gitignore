__pycache__/
*.pyc

# 構築済みの索引。core/config.py の既定が <repo>/index/massbank.sqlite で
# 作業ツリーの中を指すため、放っておくと数百 MB の SQLite が git status に
# 並び、事故で commit されうる。サイズだけの問題ではない: spec §4 が
# ハイブリッド方式を採ったのは、再配布可能な MassBank の中身を成果物に
# 焼き込まないためでもある（コーパスの一部は CC-BY）。
#
# 先頭の / は必須。アンカーしないと Git はこれを「任意の階層の index/」と
# 解釈し、パッケージ本体の massbank_context/index/ まで無視する。追跡済みの
# ファイルは影響を受けないが、そこに新しいモジュールを足すと静かに追跡漏れする。
/index/
*.sqlite

# MassBank の上流リポジトリは、それぞれ独立した Git 履歴とライセンスを持つ。
# 親リポジトリへ内容を取り込まず、ローカルの参照用 nested clone として保持する。
/MassBank-RDF/
/MassbankRdf/
